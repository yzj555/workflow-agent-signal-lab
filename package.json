{
  "name": "@local/workflow-agent-signal-lab",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "description": "A real DSH signal-lab bundle for testing the Workflow Agent preset and its read-only workflow projection.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./workflow-runtime": "./lib/workflow-runtime.js",
    "./workflow-control": "./lib/workflow-control.js",
    "./workflow-engine": "./lib/workflow-engine.js",
    "./workflow-preset": "./lib/workflow-preset.js",
    "./workflow-pwsh": "./lib/workflow-pwsh.js",
    "./profile-guard": "./scripts/workflow-profile-guard.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-user-questions"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node node_modules/tsdown/dist/run.mjs --config tsdown.config.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.client.json",
    "test": "node --test tests/*.test.mjs",
    "release:build": "node scripts/build-release.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
