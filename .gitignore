# Public repository allow-list. Local operations/data are not publication inputs.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/tsconfig.base.json
!/tsconfig.client.json
!/tsdown.config.ts
!/cordis.patch.example.yml
!/src/
!/tests/
!/preset/
!/docs/
!/scripts/
!/release/
!/tsdown.release.config.ts

# Never publish runtime databases, sessions, credentials or machine configuration.
**/.dsh/
**/.git/
**/node_modules*/
/lib/
**/dist/
**/build/
**/coverage/
**/.env
**/.env.*
**/.credentials*
**/credentials.yaml
**/credentials.yml
**/.npmrc
**/.netrc
**/*.log
**/*.sqlite*
**/*.db
**/*.db-*
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/id_rsa*
**/id_ed25519*
**/__pycache__/

# Not the plugin: independent task produced during earlier experiments.
/port-inspector/
/packages/
/cordis.patch.yml
/start-lab.ps1
